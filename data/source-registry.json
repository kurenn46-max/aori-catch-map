  "required_fields": [
    "date",
    "area",
    "place",
    "type",
    "source",
    "url"
  ],
  "reject_if": [
    "実釣日不明",
    "陸/船不明",
    "出典URLなし",
    "対象海域外",
    "転載元不明"
  ],
  "bait_collection": {
    "direct_bait_species": [
      "豆アジ",
      "小アジ",
      "アジ",
      "カタクチイワシ",
      "マイワシ",
      "ウルメイワシ",
      "サヨリ",
      "キビナゴ",
      "小サバ",
      "稚魚",
      "小魚"
    ],
    "indirect_predator_signals": [
      "サゴシ",
      "サワラ",
      "ツバス",
      "ハマチ",
      "シーバス",
      "カマス"
    ],
    "weak_relevance": [
      "キス",
      "カワハギ",
      "根魚",
      "チヌ",
      "グレ"
    ],
    "rules": [
      "岸または港内でアジ・イワシ・サヨリ等の小型回遊魚がまとまって釣れている情報を最優先",
      "釣れた時間帯・場所・サイズ・数が分かる場合は保持",
      "青物やサゴシ等の捕食魚はベイト存在の間接指標として扱う",
      "底物や根魚の釣果だけではベイト濃度の強い指標にしない",
      "船沖の魚情報はshore_relevance=lowとして岸の評価と分離"
    ]
  },
  "catch_quality_fields": {
    "duration_hours": "釣行時間が確認できた場合のみ",
    "angler_count": "人数が確認できた場合のみ",
    "cpue": "count/(duration_hours*angler_count)。3項目すべて確認できた場合のみ算出",
    "session_rate": "人数不明でもcountとduration_hoursが確認できた場合の全体杯数/時間",
    "result_status": [
      "catch",
      "blank",
      "chase_only",
      "sighting_only"
    ],
    "rule": "0杯・チェイスのみ・見えイカのみも、実釣日/場所/出典が確認できれば重要な負の情報として保存する"
  },
  "decision_signals": {
    "priority_order": [
      "直近48時間の陸っぱり実釣セッション",
      "同一釣行内の複数HIT・最大サイズ・時間帯",
      "ボウズ/チェイスのみ/見えイカのみ等の負の実釣情報",
      "岸ベイト（アジ・イワシ・サヨリ等）",
      "釣り人密度・ヤエン占有・スレ材料",
      "風向/平均風/最大瞬間風速/波/うねり",
      "潮位変化と上げ下げ・まずめ",
      "表面水温と24h/72h変化",
      "前24h/72h降水と濁りの実地報告",
      "釣禁・立入禁止・駐車・工事等の現地条件"
    ],
    "optional_catch_fields": [
      "angler",
      "session_id",
      "terrain",
      "egi_size",
      "egi_color",
      "egi_model",
      "range",
      "depth_hint",
      "action",
      "retrieve_style",
      "duration_hours",
      "angler_count",
      "water_clarity",
      "bait_seen",
      "pressure_note",
      "weather_note"
    ],
    "rules": [
      "投稿数と釣行数を分ける。同じ投稿者・同日・同海域の連投は原則1釣行セッションとして集計する",
      "HIT数や投稿件数を杯数とみなさない。本文に杯数が明記されない限りcount=null",
      "直近48時間を最重要、7日を補助、30日はパターン学習用とする",
      "エギの号数・色・レンジ・アクションは本文で明示された場合だけ保存",
      "濁り・水色・人圧・ベイトは現地報告が最優先。気象から推測する場合は別の推定指標として扱う",
      "船の好釣果は魚影の補助材料に使うが、岸エギングの好調判定を直接押し上げすぎない"
    ]
  },
