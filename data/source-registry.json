  "discovery_pipeline": {
    "stages": [
      "固定情報源を巡回して新着を取得",
      "地域名×アオリイカ×ティップラン×釣果×水深等のキーワードで新しい公開情報源候補を発見",
      "一覧ページから個別釣果記事へ辿り、実釣日・岸/船・昼/夜・負情報・レンジを精査",
      "A/Bだけを判断材料へ。C・告知・募集はレビュー/参考情報として保持",
      "同一情報源・同日・同海域・同釣法はセッション圧縮し、一覧と詳細の二重計上を防ぐ"
    ],
    "blocked_policy": "取得制限・403・本文省略は『釣果0』にしない。blocked/unavailableとして別管理する。",
    "candidate_policy": "Yahoo Japanの公開検索結果で新規候補を発見し、実ページ再取得後にA/B/Cへ精査。検索スニペットは釣果判定へ入れず、候補はauto_promote=falseで保持し、一次情報源確認後のみ固定巡回へ昇格する。"
  },
  "boat_depth_collection": {
    "purpose": "昼の船実釣を沖の魚影・レンジ実測として保持し、将来の夕まずめ岸ポイント絞り込みの補助材料にする。船釣果は岸評価へ直接加点しない。",
    "fields": [
      "date",
      "area",
      "source",
      "url",
      "time_mode",
      "depth_m",
      "bottom_offset_m",
      "tana_m",
      "depth_confidence",
      "negative_signals"
    ],
    "definitions": {
      "depth_m": "記事が『水深』として明示した海底/ポイント水深",
      "bottom_offset_m": "『ボトムから5m』等、海底から上のヒットレンジ。水深として扱わない",
      "tana_m": "棚/タナとして明示された水面基準のレンジ",
      "time_mode": "day/night/mixed/unknown。夕まずめ岸予測へ使う際はdayを優先"
    },
    "rules": [
      "別魚種の水深をアオリ水深へ転用しない",
      "記事タイトルがアオリ/ティップランを明示する場合のみ、同記事内の実釣日段落へ魚種/釣法文脈を継承できる",
      "水深実測は希少なため30日保持するが、日付と確度を必ず表示する",
      "昼/夜の船情報は別セッションとして保持する",
      "告知・募集・予約情報だけの記事は実釣判断へ使わない"
    ]
  }
}
